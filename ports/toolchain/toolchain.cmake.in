# Toolchain
include_guard(GLOBAL)

# System
set(CMAKE_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@" CACHE STRING "")
set(CMAKE_SYSTEM_VERSION "@CMAKE_SYSTEM_VERSION@" CACHE STRING "")
set(CMAKE_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@" CACHE STRING "")

# Programs
if("@CMAKE_GENERATOR@" STREQUAL "Ninja" AND CMAKE_GENERATOR MATCHES "^Ninja")
  set(CMAKE_MAKE_PROGRAM "@CMAKE_MAKE_PROGRAM@" CACHE PATH "")
  set(CMAKE_C_COMPILER "@CMAKE_C_COMPILER@" CACHE PATH "")
  set(CMAKE_CXX_COMPILER "@CMAKE_CXX_COMPILER@" CACHE PATH "")
  set(CMAKE_ASM_MASM_COMPILER "@CMAKE_ASM_MASM_COMPILER@" CACHE PATH "")
  set(CMAKE_RC_COMPILER "@CMAKE_RC_COMPILER@" CACHE PATH "")
  set(CMAKE_LINKER "@CMAKE_LINKER@" CACHE PATH "")
  set(CMAKE_AR "@CMAKE_AR@" CACHE PATH "")
  set(CMAKE_MT "@CMAKE_MT@" CACHE PATH "")
endif()

# Compiler Flags
set(CMAKE_C_FLAGS_INIT "@CMAKE_C_FLAGS_INIT@")
set(CMAKE_C_FLAGS_DEBUG_INIT "@CMAKE_C_FLAGS_DEBUG_INIT@")
set(CMAKE_C_FLAGS_RELEASE_INIT "@CMAKE_C_FLAGS_RELEASE_INIT@")

set(CMAKE_CXX_FLAGS_INIT "@CMAKE_CXX_FLAGS_INIT@")
set(CMAKE_CXX_FLAGS_DEBUG_INIT "@CMAKE_CXX_FLAGS_DEBUG_INIT@")
set(CMAKE_CXX_FLAGS_RELEASE_INIT "@CMAKE_CXX_FLAGS_RELEASE_INIT@")

set(CMAKE_ASM_MASM_FLAGS_INIT "@CMAKE_ASM_MASM_FLAGS_INIT@")
set(CMAKE_ASM_MASM_FLAGS_DEBUG_INIT "@CMAKE_ASM_MASM_FLAGS_DEBUG_INIT@")
set(CMAKE_ASM_MASM_FLAGS_RELEASE_INIT "@CMAKE_ASM_MASM_FLAGS_RELEASE_INIT@")

set(CMAKE_RC_FLAGS_INIT "@CMAKE_RC_FLAGS_INIT@")

# Linker Flags
set(CMAKE_EXE_LINKER_FLAGS_INIT "@CMAKE_EXE_LINKER_FLAGS_INIT@")
set(CMAKE_EXE_LINKER_FLAGS_DEBUG_INIT "@CMAKE_EXE_LINKER_FLAGS_DEBUG_INIT@")
set(CMAKE_EXE_LINKER_FLAGS_RELEASE_INIT "@CMAKE_EXE_LINKER_FLAGS_RELEASE_INIT@")

set(CMAKE_SHARED_LINKER_FLAGS_INIT "@CMAKE_SHARED_LINKER_FLAGS_INIT@")
set(CMAKE_SHARED_LINKER_FLAGS_DEBUG_INIT "@CMAKE_SHARED_LINKER_FLAGS_DEBUG_INIT@")
set(CMAKE_SHARED_LINKER_FLAGS_RELEASE_INIT "@CMAKE_SHARED_LINKER_FLAGS_RELEASE_INIT@")

set(CMAKE_ARCHIVE_LINKER_FLAGS_INIT "@CMAKE_ARCHIVE_LINKER_FLAGS_INIT@")
set(CMAKE_ARCHIVE_LINKER_FLAGS_DEBUG_INIT "@CMAKE_ARCHIVE_LINKER_FLAGS_DEBUG_INIT@")
set(CMAKE_ARCHIVE_LINKER_FLAGS_RELEASE_INIT "@CMAKE_ARCHIVE_LINKER_FLAGS_RELEASE_INIT@")

set(CMAKE_STATIC_LINKER_FLAGS_INIT "@CMAKE_STATIC_LINKER_FLAGS_INIT@")
set(CMAKE_STATIC_LINKER_FLAGS_DEBUG_INIT "@CMAKE_STATIC_LINKER_FLAGS_DEBUG_INIT@")
set(CMAKE_STATIC_LINKER_FLAGS_RELEASE_INIT "@CMAKE_STATIC_LINKER_FLAGS_RELEASE_INIT@")

# Include Directories
include_directories(BEFORE SYSTEM "@TOOLCHAIN_INCLUDE_DIRECTORIES@")

# Link Directories
link_directories(BEFORE "@TOOLCHAIN_LINK_DIRECTORIES@")
